APP_NAME="Clinic CRM"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://example.com
FRONTEND_URL=https://example.com

APP_LOCALE=fa
APP_FALLBACK_LOCALE=fa
LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=clinic_database
DB_USERNAME=clinic_user
DB_PASSWORD=CHANGE_ME

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SANCTUM_STATEFUL_DOMAINS=example.com

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=public
BROADCAST_CONNECTION=reverb

REVERB_APP_ID=CHANGE_ME
REVERB_APP_KEY=CHANGE_ME
REVERB_APP_SECRET=CHANGE_ME
REVERB_HOST=example.com
REVERB_PORT=443
REVERB_SCHEME=https
REVERB_SERVER_HOST=127.0.0.1
REVERB_SERVER_PORT=8080
REVERB_SCALING_ENABLED=false
REVERB_ALLOWED_ORIGINS=app.example.com
REVERB_APP_PING_INTERVAL=45
REVERB_APP_ACTIVITY_TIMEOUT=30

SHSMS_ENDPOINT=
SHSMS_TOKEN=
SHSMS_SENDER=
TREATMENT_GUIDE_URL=

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"
